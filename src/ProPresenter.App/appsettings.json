{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      // The handler logs every request and every failure with a full stack trace, twice per attempt
      // per client. While ProPresenter is unreachable this app retries forever, so at Information it
      // buries everything else. Our own clients report connection problems in readable form.
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://0.0.0.0:8752"
}
